#!/bin/bash
# Stub `go` for scripts/test/. Intercepts the two calls validate_mvs_floors
# makes (sync-versions.sh:394,417):
#   env GOWORK=off go list -C "$REPO_ROOT" -mod=readonly -m -f '{{.GoMod}}' <module>
#   GOWORK=off go mod edit -json <path>
# Mode selected by $STUB_GO_MODE (default "ok"). See scripts/test/lib.sh's
# header comment for the full mode table and rationale.
set -euo pipefail

mode="${STUB_GO_MODE:-ok}"

# Canned answer for "what does floor-owner's go.mod require for floor-dep" --
# fixed regardless of mode. Cases mutate the ACTUAL go.mod pin instead (see
# fixtures/base/go.mod), never this constant, so a mismatch always means a
# case mutated the real pin, not this stub. Must match lib.sh's
# FLOOR_REQUIRE_PATH/FLOOR_REQUIRE_VERSION.
FLOOR_REQUIRE_PATH="github.com/example/floor-dep"
FLOOR_REQUIRE_VERSION="v0.5.1"

if [[ "${1:-}" == "list" ]]; then
    shift
    root=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -C) root="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    # Invocation-shape check: sync-versions.sh:394 must pass -C "$REPO_ROOT"
    # -- dropping it (an oracle mutation this harness must be able to catch)
    # makes this branch never match, degrading to the same failure as
    # STUB_GO_MODE=missing regardless of the configured mode.
    if [[ -z "$root" || "$root" != "${SYNC_VERSIONS_REPO_ROOT:-}" ]]; then
        exit 1
    fi
    case "$mode" in
        ok|norequire|editfail)
            echo "$root/floor/go.mod"
            exit 0
            ;;
        missing)
            exit 1
            ;;
        badpath)
            echo "$root/floor/does-not-exist.mod"
            exit 0
            ;;
        hang)
            # Fake a stuck probe that records its own fate in
            # $STUB_GO_HANG_LOG (a "start" line, then "killed <age>" or
            # "completed <age>"), so case 09 times the probe alone rather
            # than the whole `check` run. <age> is this process's age in
            # whole seconds from `ps -o etime=`: `timeout` forked this PID and
            # `env` and the interpreter exec in place, so the age runs from
            # the moment `timeout` started counting, slow startup included.
            # The sleep outlasts the 10s production default, so an ignored
            # override shows as a kill near 10s and a missing timeout as
            # "completed". It runs in the background so the TERM trap fires
            # at once (bash defers a trap until a foreground child exits),
            # and the trap kills it so no orphan keeps the caller's $(...)
            # pipe open. The trap is armed before anything else, so an early
            # TERM still gets logged, and it ignores TERM itself: `timeout`
            # signals the child and then its whole process group, which
            # would also kill the trap's `ps` subshell.
            log="${STUB_GO_HANG_LOG:?stub go: hang mode needs STUB_GO_HANG_LOG}"
            sleeper=""
            # age_s -- set $age to this process's age in seconds, from
            # etime's [[dd-]hh:]mm:ss (GNU and BSD ps alike); "" if unreadable.
            age_s() {
                local et d=0 h=0 m s rest
                et=$(ps -o etime= -p "$$" 2>/dev/null | tr -d ' ') || et=""
                case "$et" in *-*) d="${et%%-*}"; et="${et#*-}" ;; esac
                s="${et##*:}"
                rest="${et%:*}"
                m="${rest##*:}"
                if [[ "$rest" == *:* ]]; then h="${rest%%:*}"; fi
                age=""
                if [[ "$et" == *:* && "$d$h$m$s" =~ ^[0-9]+$ ]]; then
                    age=$(( 10#$d * 86400 + 10#$h * 3600 + 10#$m * 60 + 10#$s ))
                fi
            }
            trap 'trap "" TERM; if [[ -n "$sleeper" ]]; then kill "$sleeper" 2>/dev/null || true; fi; age_s; echo "killed $age" >> "$log"; exit 143' TERM
            echo "start" >> "$log"
            sleep 30 >/dev/null 2>&1 &
            sleeper=$!
            wait "$sleeper"
            age_s
            echo "completed $age" >> "$log"
            echo "$root/floor/go.mod"
            exit 0
            ;;
        *)
            exit 1
            ;;
    esac
elif [[ "${1:-}" == "mod" && "${2:-}" == "edit" ]]; then
    # Invocation-shape check: sync-versions.sh:417 must run this with
    # GOWORK=off in its environment -- dropping it (the other oracle
    # mutation) makes this branch behave as editfail regardless of mode.
    if [[ "${GOWORK:-}" != "off" ]]; then
        exit 3
    fi
    case "$mode" in
        ok)
            printf '{"Require":[{"Path":"%s","Version":"%s"}]}\n' \
                "$FLOOR_REQUIRE_PATH" "$FLOOR_REQUIRE_VERSION"
            exit 0
            ;;
        norequire)
            printf '{"Require":[]}\n'
            exit 0
            ;;
        editfail)
            exit 3
            ;;
        *)
            exit 3
            ;;
    esac
else
    echo "stub-go: unhandled invocation: $*" >&2
    exit 1
fi
